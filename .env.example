# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ── Vector store ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://compliancerag:compliancerag@localhost:5432/compliancerag

# ── Analytics ────────────────────────────────────────────────────────────────
ATHENA_DATABASE=compliancerag
ATHENA_TABLE_FINES=gdpr_fines
ATHENA_S3_DATA_BUCKET=                       # set from: terraform output analytics_data_bucket
ATHENA_S3_OUTPUT=                            # set from: terraform output athena_s3_output

# ── Reranker ─────────────────────────────────────────────────────────────────
RERANKER_ENABLED=true

# ── Online evaluation ─────────────────────────────────────────────────────────
ONLINE_EVAL_SAMPLE_RATE=0.1

# ── API ──────────────────────────────────────────────────────────────────────
API_KEY=                                     # simple API key auth for PoC
API_HOST=0.0.0.0
API_PORT=8000
