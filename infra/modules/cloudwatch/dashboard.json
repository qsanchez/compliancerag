{
  "widgets": [
    {
      "type": "metric",
      "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "API Gateway Latency (ms)",
        "metrics": [
          ["AWS/ApiGateway", "Latency", "ApiId", "${api_id}", { "stat": "p50", "label": "P50" }],
          ["AWS/ApiGateway", "Latency", "ApiId", "${api_id}", { "stat": "p90", "label": "P90" }],
          ["AWS/ApiGateway", "Latency", "ApiId", "${api_id}", { "stat": "p99", "label": "P99" }]
        ],
        "view": "timeSeries", "period": 300, "region": "${aws_region}",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Lambda Duration (ms)",
        "metrics": [
          ["AWS/Lambda", "Duration", "FunctionName", "${lambda_name}", { "stat": "p50", "label": "P50" }],
          ["AWS/Lambda", "Duration", "FunctionName", "${lambda_name}", { "stat": "p99", "label": "P99" }]
        ],
        "view": "timeSeries", "period": 300, "region": "${aws_region}",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Per-span Latency (ms) — Retrieve / Rerank / Generate",
        "metrics": [
          ["ComplianceRAG/${environment}", "RetrieveMs", { "stat": "Average", "label": "Retrieve (avg)" }],
          ["ComplianceRAG/${environment}", "RerankMs",   { "stat": "Average", "label": "Rerank (avg)" }],
          ["ComplianceRAG/${environment}", "GenerateMs", { "stat": "Average", "label": "Generate (avg)" }]
        ],
        "view": "timeSeries", "period": 300, "region": "${aws_region}",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 6, "width": 12, "height": 6,
      "properties": {
        "title": "Token Usage per Query",
        "metrics": [
          ["ComplianceRAG/${environment}", "InputTokens",  { "stat": "Average", "label": "Input tokens (avg)" }],
          ["ComplianceRAG/${environment}", "OutputTokens", { "stat": "Average", "label": "Output tokens (avg)" }]
        ],
        "view": "timeSeries", "period": 300, "region": "${aws_region}",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 12, "width": 12, "height": 6,
      "properties": {
        "title": "LLM Cost (USD) — token-based",
        "metrics": [
          [{ "expression": "m1 * 1000", "label": "Total cost (USD × 1000)", "id": "e1" }],
          ["ComplianceRAG/${environment}", "CostUsd", { "stat": "Sum", "id": "m1", "visible": false, "period": 300 }]
        ],
        "view": "timeSeries", "period": 300, "region": "${aws_region}",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 12, "width": 12, "height": 6,
      "properties": {
        "title": "Online RAGAS Quality — Faithfulness & Answer Relevancy",
        "metrics": [
          ["ComplianceRAG/${environment}", "OnlineFaithfulness",    { "stat": "Average", "label": "Faithfulness (1h avg)" }],
          ["ComplianceRAG/${environment}", "OnlineAnswerRelevancy", { "stat": "Average", "label": "Answer Relevancy (1h avg)" }]
        ],
        "view": "timeSeries", "period": 3600, "region": "${aws_region}",
        "yAxis": { "left": { "min": 0, "max": 1 } }
      }
    },
    {
      "type": "metric",
      "x": 0, "y": 18, "width": 12, "height": 6,
      "properties": {
        "title": "Error Rate",
        "metrics": [
          ["AWS/Lambda", "Errors", "FunctionName", "${lambda_name}", { "stat": "Sum", "label": "Lambda Errors", "color": "#d62728" }],
          ["AWS/ApiGateway", "5XXError", "ApiId", "${api_id}", { "stat": "Sum", "label": "API GW 5XX", "color": "#ff7f0e" }],
          ["AWS/ApiGateway", "4XXError", "ApiId", "${api_id}", { "stat": "Sum", "label": "API GW 4XX", "color": "#aec7e8" }]
        ],
        "view": "timeSeries", "period": 300, "region": "${aws_region}",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 12, "y": 18, "width": 12, "height": 6,
      "properties": {
        "title": "Infrastructure Health",
        "metrics": [
          ["AWS/RDS", "CPUUtilization", "DBInstanceIdentifier", "${rds_identifier}", { "stat": "Average", "label": "RDS CPU %" }],
          ["AWS/Lambda", "Throttles", "FunctionName", "${lambda_name}", { "stat": "Sum", "label": "Lambda Throttles", "yAxis": "right" }]
        ],
        "view": "timeSeries", "period": 300, "region": "${aws_region}",
        "yAxis": { "left": { "min": 0, "max": 100 }, "right": { "min": 0 } }
      }
    }
  ]
}
