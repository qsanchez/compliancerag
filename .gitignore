# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.uv/
*.egg-info/
dist/
build/

# Environment
.env

# Evaluation reports (keep summaries, not full outputs)
evaluation/reports/*
!evaluation/reports/.gitkeep

# Tool caches
.pytest_cache/
.ruff_cache/

# Local dev tool config
.claude/settings.local.json

# IDE
.vscode/
.idea/
*.swp

# macOS
.DS_Store

# Terraform state and sensitive vars
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.backup
infra/environments/prod.tfvars

# Test coverage
.coverage
htmlcov/

# Runtime data (created by ingestion pipeline and local vector store)
chroma_db/
data/
*.log

# Ingestion cache (downloaded source documents)
.cache/
.$compliancerag.drawio.bkp
