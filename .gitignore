# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.uv/
*.egg-info/
dist/
build/

# Environment
.env

# Evaluation reports — ignore ad-hoc runs, track phase baselines
evaluation/reports/*
!evaluation/reports/.gitkeep
!evaluation/reports/phase_*.json

# Tool caches
.pytest_cache/
.ruff_cache/

# Local dev tool config
.claude/settings.local.json

# IDE
.vscode/
.idea/
*.swp

# macOS
.DS_Store

# Frontend generated config (contains live URLs, generated by task frontend:config)
frontend/config.js

# Terraform state and sensitive vars
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.backup
infra/environments/*.tfvars

# Test coverage
.coverage
htmlcov/

# Runtime data (created by ingestion pipeline and local vector store)
chroma_db/
data/
*.log

# Ingestion cache (downloaded source documents)
.cache/

# Generated analytics artifacts (Parquet files built by analytics:load)
analytics/datasets/*.parquet
analytics_etl/datasets/*.parquet

# draw.io temp/backup files
*.drawio.dtmp
*.drawio.bkp
