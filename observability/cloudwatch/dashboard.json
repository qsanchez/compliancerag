{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "API Gateway Latency (ms)",
        "metrics": [
          ["AWS/ApiGateway", "Latency", "ApiId", "${api_id}", { "stat": "p50", "label": "P50" }],
          ["AWS/ApiGateway", "Latency", "ApiId", "${api_id}", { "stat": "p90", "label": "P90" }],
          ["AWS/ApiGateway", "Latency", "ApiId", "${api_id}", { "stat": "p99", "label": "P99" }]
        ],
        "view": "timeSeries",
        "period": 300,
        "region": "${aws_region}",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Lambda Duration (ms)",
        "metrics": [
          ["AWS/Lambda", "Duration", "FunctionName", "${lambda_name}", { "stat": "p50", "label": "P50" }],
          ["AWS/Lambda", "Duration", "FunctionName", "${lambda_name}", { "stat": "p99", "label": "P99" }]
        ],
        "view": "timeSeries",
        "period": 300,
        "region": "${aws_region}",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Request Count",
        "metrics": [
          ["AWS/ApiGateway", "Count", "ApiId", "${api_id}", { "stat": "Sum", "label": "Requests" }]
        ],
        "view": "timeSeries",
        "period": 300,
        "region": "${aws_region}",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Estimated Lambda Cost (USD)",
        "metrics": [
          [{ "expression": "m1 / 1000 * (${lambda_memory} / 1024) * 0.0000166667", "label": "Estimated Cost (USD)", "id": "e1" }],
          ["AWS/Lambda", "Duration", "FunctionName", "${lambda_name}", { "stat": "Sum", "id": "m1", "visible": false, "period": 300 }]
        ],
        "view": "timeSeries",
        "period": 300,
        "region": "${aws_region}",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Error Rate",
        "metrics": [
          ["AWS/Lambda", "Errors", "FunctionName", "${lambda_name}", { "stat": "Sum", "label": "Lambda Errors", "color": "#d62728" }],
          ["AWS/ApiGateway", "5XXError", "ApiId", "${api_id}", { "stat": "Sum", "label": "API GW 5XX", "color": "#ff7f0e" }],
          ["AWS/ApiGateway", "4XXError", "ApiId", "${api_id}", { "stat": "Sum", "label": "API GW 4XX", "color": "#aec7e8" }]
        ],
        "view": "timeSeries",
        "period": 300,
        "region": "${aws_region}",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 12,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Infrastructure Health",
        "metrics": [
          ["AWS/RDS", "CPUUtilization", "DBInstanceIdentifier", "${rds_identifier}", { "stat": "Average", "label": "RDS CPU %" }],
          ["AWS/Lambda", "Throttles", "FunctionName", "${lambda_name}", { "stat": "Sum", "label": "Lambda Throttles", "yAxis": "right" }]
        ],
        "view": "timeSeries",
        "period": 300,
        "region": "${aws_region}",
        "yAxis": {
          "left": { "min": 0, "max": 100 },
          "right": { "min": 0 }
        }
      }
    }
  ]
}
